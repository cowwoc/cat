{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear)$",
        "hooks": [
          {
            "type": "command",
            "command": "${CAT_PLUGIN_ROOT}/client/bin/session-start"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CAT_PLUGIN_ROOT}/client/bin/subagent-start"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^(Bash|functions\\.exec_command)$",
        "hooks": [
          {
            "type": "command",
            "command": "${CAT_PLUGIN_ROOT}/client/bin/pre-bash"
          }
        ]
      }
    ]
  }
}
